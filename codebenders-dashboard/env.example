# Database Configuration (Supabase Postgres)
# Local development (supabase start)
DB_HOST=127.0.0.1
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=54332
DB_NAME=postgres
# Set DB_SSL=true for hosted Supabase; leave false or unset for local dev
DB_SSL=false

# OpenAI Configuration (for AI-powered query generation)
OPENAI_API_KEY=your-openai-api-key-here

# Supabase Auth (required for RBAC)
# Find these in Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Self-service data upload (admin/ir only)
# Supabase service role key — used to write files to the pdp-uploads Storage bucket
# Find in Supabase → Project Settings → API → service_role (secret key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# GitHub Actions ML pipeline trigger — used to dispatch repository_dispatch after PDP/AR upload
# Create a PAT at GitHub → Settings → Developer settings → Personal access tokens → Fine-grained
# Required permission: Actions (write) on this repository
GITHUB_PAT=ghp_your-personal-access-token-here
# Full repo path: owner/repo-name
GITHUB_REPO=devcolor/codebenders-datathon
